#!/usr/bin/env python3
"""One local command for the Learn Ghostty cockpit."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time
import urllib.request
import webbrowser

ROOT = Path(__file__).resolve().parent
STATE = ROOT / "learner" / "state.json"
MANIFEST = ROOT / "course" / "manifest.json"
URL = "http://127.0.0.1:4173"
PID_FILE = ROOT / ".course-server.pid"


def load(path: Path):
    return json.loads(path.read_text())


def lesson():
    state = load(STATE)
    manifest = load(MANIFEST)
    current = next(item for item in manifest["lessons"] if item["id"] == state["currentLesson"])
    return state, current


def server_up() -> bool:
    try:
        with urllib.request.urlopen(f"{URL}/api/health", timeout=0.4) as response:
            return response.status == 200
    except Exception:
        return False


def cmd_doctor(_args):
    checks = [
        ("git", shutil.which("git")),
        ("node", shutil.which("node")),
        ("npm", shutil.which("npm")),
        ("Ghostty submodule", (ROOT / "ghostty" / "src" / "Surface.zig").exists()),
        ("course manifest", MANIFEST.exists()),
        ("learner state", STATE.exists()),
    ]
    failed = False
    print("Learn Ghostty doctor\n")
    for name, result in checks:
        ok = bool(result)
        failed |= not ok
        print(f"{'✓' if ok else '✗'} {name}")
    if not (ROOT / "node_modules").exists():
        print("△ dependencies are not installed; run: npm install")
    print(f"\n{'Ready to learn.' if not failed else 'Fix the failed checks above.'}")
    return int(failed)


def cmd_status(args):
    state, current = lesson()
    value = {
        "currentLesson": current,
        "currentStep": state["currentStep"],
        "progress": state["lessons"].get(current["id"], {}),
        "server": {"running": server_up(), "url": f"{URL}{current['path']}"},
        "lastActivity": state.get("activity", [])[:3],
    }
    if args.json:
        print(json.dumps(value, indent=2))
    else:
        progress = value["progress"]
        print(f"Current lesson: {current['title']}")
        print(f"Next step:      {state['currentStep']}")
        print(f"Completion:     {progress.get('completion', 0)}%")
        print(f"Mastery:        {progress.get('mastery', 0)}%")
        print(f"Dashboard:      {URL}{current['path']}")
        print(f"Server:         {'running' if value['server']['running'] else 'stopped'}")
    return 0


def cmd_serve(args):
    if server_up():
        print(f"Learning cockpit already running at {URL}")
        return 0
    if not (ROOT / "node_modules").exists():
        subprocess.run(["npm", "install"], cwd=ROOT, check=True)
    command = ["npm", "run", "dev"]
    if not args.background:
        return subprocess.run(command, cwd=ROOT).returncode
    log = open(ROOT / ".course-server.log", "a")
    process = subprocess.Popen(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    PID_FILE.write_text(f"{process.pid}\n")
    for _ in range(40):
        if server_up():
            print(f"Learning cockpit started at {URL}")
            return 0
        time.sleep(0.25)
    print("Server did not become ready; inspect .course-server.log", file=sys.stderr)
    return 1


def cmd_open(args):
    if not server_up():
        code = cmd_serve(argparse.Namespace(background=True))
        if code:
            return code
    state, current = lesson()
    target = URL if args.dashboard else f"{URL}{current['path']}"
    webbrowser.open(target)
    print(target)
    return 0


def cmd_build(_args):
    if not (ROOT / "node_modules").exists():
        subprocess.run(["npm", "install"], cwd=ROOT, check=True)
    subprocess.run(["npm", "run", "check"], cwd=ROOT, check=True)
    return subprocess.run(["npm", "run", "build"], cwd=ROOT).returncode


def main():
    parser = argparse.ArgumentParser(prog="camp", description="Learn Ghostty course cockpit")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor").set_defaults(func=cmd_doctor)
    status = commands.add_parser("status")
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=cmd_status)
    commands.add_parser("next").set_defaults(func=cmd_status, json=False)
    serve = commands.add_parser("serve")
    serve.add_argument("--background", action="store_true")
    serve.set_defaults(func=cmd_serve)
    open_cmd = commands.add_parser("open")
    open_cmd.add_argument("--dashboard", action="store_true")
    open_cmd.set_defaults(func=cmd_open)
    commands.add_parser("build").set_defaults(func=cmd_build)
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
