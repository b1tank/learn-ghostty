---
const { current = 'Process entry' } = Astro.props;
const stages = [
  'Process entry',
  'App lifecycle',
  'Runtime + Surface',
  'Child process + PTY',
  'I/O + parser',
  'Terminal state',
  'Window + GPU + fonts',
];
const currentIndex = Math.max(0, stages.indexOf(current));
const stateFor = (index) => index < currentIndex ? 'complete' : index === currentIndex ? 'current' : index === currentIndex + 1 ? 'next' : 'future';
const captionFor = (state) => ({ complete: 'Reconstructed', current: 'You are here', next: 'Next limitation', future: 'Not introduced' })[state];
---
<section class="frontier-map" aria-labelledby="frontier-title">
  <header>
    <p>DEPENDENCY FRONTIER</p>
    <h2 id="frontier-title">Build only what the current result needs</h2>
  </header>
  <ol>
    {stages.map((label, index) => {
      const state = stateFor(index);
      return <li class={`is-${state}`}>
        <span>{String(index).padStart(2, '0')}</span>
        <strong>{label}</strong>
        <small>{captionFor(state)}</small>
      </li>;
    })}
  </ol>
</section>
