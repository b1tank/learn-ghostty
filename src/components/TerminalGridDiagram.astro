<figure class="terminal-grid" aria-labelledby="terminal-grid-title">
  <figcaption id="terminal-grid-title"><span>DURABLE STATE</span><strong>Parser actions become styled cells and a cursor</strong></figcaption>
  <div class="terminal-grid__screen" role="img" aria-label="Three row terminal grid. Row zero says ready greater-than hello in default style. Row one says reply colon hello in green. Cursor begins row two.">
    <div class="row"><b>0</b>{[...'ready>hello'].map((char)=><i>{char}</i>)}{Array.from({length:13},()=> <i></i>)}</div>
    <div class="row"><b>1</b>{[...'reply:hello'].map((char)=><i class="green">{char}</i>)}{Array.from({length:13},()=> <i></i>)}</div>
    <div class="row"><b>2</b><i class="cursor"></i>{Array.from({length:23},()=> <i></i>)}</div>
  </div>
  <ol><li><code>print</code><span>write char + current style, advance cursor</span></li><li><code>CR</code><span>cursor column → 0</span></li><li><code>LF</code><span>cursor row → next row</span></li><li><code>SGR 32 / 0</code><span>current style → green / default</span></li></ol>
</figure>
<style>
.terminal-grid{margin:1.5rem 0;padding:1.25rem;border:1px solid var(--course-border);border-radius:var(--course-radius-md);background:var(--course-surface);container:grid/inline-size}.terminal-grid figcaption span,.terminal-grid figcaption strong{display:block}.terminal-grid figcaption span{color:var(--sl-color-text-accent);font:700 var(--sl-text-2xs) var(--__sl-font-mono);letter-spacing:.06em}.terminal-grid figcaption strong{margin-top:.3rem;font-size:var(--sl-text-xl)}.terminal-grid__screen{margin-top:1rem;overflow:hidden;padding:.8rem;border:1px solid var(--course-border);border-radius:.5rem;background:var(--lg-code-shell)}.terminal-grid .row{display:grid;grid-template-columns:1.5rem repeat(24,1fr);min-width:0}.terminal-grid .row b{color:var(--lg-code-muted);font:var(--sl-text-2xs) var(--__sl-font-mono)}.terminal-grid .row i{display:grid;min-height:1.7rem;place-items:center;border:1px solid hsl(220 10% 24%);color:var(--lg-code-text);font:normal clamp(.55rem,2cqi,var(--sl-text-xs)) var(--__sl-font-mono)}.terminal-grid .row i.green{color:var(--sl-color-green-high);background:color-mix(in srgb,var(--sl-color-green-low) 45%,transparent)}.terminal-grid .row i.cursor{box-shadow:inset 0 -3px var(--sl-color-accent)}.terminal-grid ol{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin:1rem 0 0;padding:0;list-style:none}.terminal-grid li{margin:0!important;padding:.65rem;border-left:2px solid var(--sl-color-accent);background:var(--course-surface-soft)}.terminal-grid li span{display:block;margin-top:.25rem;color:var(--sl-color-text);font-size:var(--sl-text-xs)}@container grid (max-width:34rem){.terminal-grid ol{grid-template-columns:1fr}}
</style>
