---
import {getLessons,groupedLessons} from "../lib/course.js";const lessons=await getLessons(),modules=groupedLessons(lessons),base=import.meta.env.BASE_URL;const url=p=>`${base}${p.replace(/^\//,'')}`;
---
<div class="home-roadmap">{modules.map(mod=><section class="roadmap-module"><div class="roadmap-module__title"><h3>{mod.name}</h3><p>{mod.summary}</p></div><div class="roadmap-lessons">{mod.lessons.map(x=>x.status==='published'?<a class="roadmap-lesson" href={url(x.href)}><span>{String(x.order).padStart(2,'0')}</span><div><strong>{x.title}</strong><small>{x.summary}</small></div><b><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9m-3-3 3 3-3 3"/></svg>Available</b></a>:<div class="roadmap-lesson"><span>{String(x.order).padStart(2,'0')}</span><div><strong>{x.title}</strong><small>{x.summary}</small></div><b><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5"/><path d="M8 5v3l2 1"/></svg>Planned</b></div>)}</div></section>)}</div>
