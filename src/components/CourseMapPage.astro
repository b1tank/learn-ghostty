---
import {getLessons,groupedLessons} from "../lib/course.js";const lessons=await getLessons(),modules=groupedLessons(lessons),base=import.meta.env.BASE_URL;const url=p=>`${base}${p.replace(/^\//,'')}`;
---
<div class="home-roadmap">{modules.map(mod=><section class="roadmap-module"><div class="roadmap-module__title"><h3>{mod.name}</h3><p>{mod.summary}</p></div><div class="roadmap-lessons">{mod.lessons.map(x=>x.status==='published'?<a class="roadmap-lesson" href={url(x.href)}><span>{String(x.order).padStart(2,'0')}</span><div><strong>{x.title}</strong><small>{x.summary}</small></div><b>Available</b></a>:<div class="roadmap-lesson"><span>{String(x.order).padStart(2,'0')}</span><div><strong>{x.title}</strong><small>{x.summary}</small></div><b>Planned</b></div>)}</div></section>)}</div>
