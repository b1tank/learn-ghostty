---
const base=import.meta.env.BASE_URL;
---
<figure class="rect-art"><figcaption><span>REAL OPENGL CAPTURE · CHAPTER 10</span><strong>One known rectangle, one known background</strong></figcaption><img src={`${base}artifacts/chapter-10-first-rectangle.png`} alt="A real Xvfb display containing a 900 by 600 dark navy GTK OpenGL surface with a centered bright green rectangle measuring 450 by 300." width="1280" height="800"/><dl><div><dt>context</dt><dd>OpenGL 4.5 core · Mesa llvmpipe</dd></div><div><dt>rectangle</dt><dd>450×300 centered in 900×600</dd></div><div><dt>pixels</dt><dd>green center · navy client · black root</dd></div></dl></figure>
<style>.rect-art{margin:1.5rem 0;overflow:hidden;border:1px solid var(--course-border);border-radius:var(--course-radius-md);background:var(--course-surface)}.rect-art figcaption{padding:1rem}.rect-art figcaption span,.rect-art figcaption strong{display:block}.rect-art figcaption span{color:var(--sl-color-text-accent);font:700 var(--sl-text-2xs) var(--__sl-font-mono)}.rect-art figcaption strong{margin-top:.3rem;font-size:var(--sl-text-xl)}.rect-art img{display:block;width:100%;height:auto}.rect-art dl{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:0;background:var(--course-border)}.rect-art dl div{padding:.75rem;background:var(--course-surface-soft)}.rect-art dt{font:700 var(--sl-text-2xs) var(--__sl-font-mono);color:var(--sl-color-text-accent)}.rect-art dd{margin:.3rem 0 0;color:var(--sl-color-text);font-size:var(--sl-text-xs)}@media(max-width:40rem){.rect-art dl{grid-template-columns:1fr}}</style>
