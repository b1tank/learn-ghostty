<figure class="pty-map" aria-labelledby="pty-map-title">
  <figcaption id="pty-map-title"><span>KERNEL RELATIONSHIP</span><strong>The parent and child see opposite ends of one terminal device</strong></figcaption>
  <div class="pty-map__flow">
    <div><small>PARENT</small><b>Surface</b><span>reads/writes master</span></div><i>↔</i>
    <div class="kernel"><small>KERNEL</small><b>PTY master</b><span>terminal-emulator side</span></div><i>↔</i>
    <div class="kernel"><small>KERNEL</small><b>PTY slave</b><span><code>/dev/pts/*</code></span></div><i>↔</i>
    <div><small>CHILD</small><b>Shell</b><span>fd 0 · 1 · 2</span></div>
  </div>
  <dl><div><dt>session</dt><dd>child is session leader</dd></div><div><dt>controlling tty</dt><dd>slave belongs to child session</dd></div><div><dt>foreground group</dt><dd>child group receives terminal input/signals</dd></div><div><dt>window</dt><dd>24 rows × 80 columns</dd></div></dl>
</figure>
<style>
.pty-map{margin:1.5rem 0;padding:1.25rem;border:1px solid var(--course-border);border-radius:var(--course-radius-md);background:var(--course-surface);container:pty/inline-size}.pty-map figcaption span,.pty-map figcaption strong,.pty-map__flow small,.pty-map__flow b,.pty-map__flow span{display:block}.pty-map figcaption span{color:var(--sl-color-text-accent);font:700 var(--sl-text-2xs) var(--__sl-font-mono);letter-spacing:.06em}.pty-map figcaption strong{margin-top:.3rem;font-size:var(--sl-text-xl)}.pty-map__flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;align-items:stretch;gap:.4rem;margin-top:1rem}.pty-map__flow>div{min-width:0;padding:.75rem;border:1px solid var(--course-border);border-radius:.5rem;background:var(--course-surface-soft)}.pty-map__flow>div.kernel{border-color:var(--sl-color-accent);background:var(--sl-color-accent-low)}.pty-map__flow>i{align-self:center;color:var(--sl-color-text-accent);font:normal 700 var(--sl-text-sm) var(--__sl-font-mono)}.pty-map__flow small{color:var(--sl-color-text-accent);font:700 var(--sl-text-2xs) var(--__sl-font-mono)}.pty-map__flow b{margin-top:.4rem;font-size:var(--sl-text-sm)}.pty-map__flow span{margin-top:.3rem;color:var(--sl-color-text);font-size:var(--sl-text-xs);line-height:1.4}.pty-map dl{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;margin:1rem 0 0}.pty-map dl div{padding:.65rem;border-left:2px solid var(--sl-color-accent);background:var(--course-surface-soft)}.pty-map dt{font:700 var(--sl-text-xs) var(--__sl-font-mono)}.pty-map dd{margin:.25rem 0 0;color:var(--sl-color-text);font-size:var(--sl-text-xs);line-height:1.4}@container pty (max-width:42rem){.pty-map__flow{grid-template-columns:1fr}.pty-map__flow>i{font-size:0;text-align:center}.pty-map__flow>i::before{content:'↕';font-size:var(--sl-text-sm)}.pty-map dl{grid-template-columns:1fr 1fr}}@container pty (max-width:28rem){.pty-map dl{grid-template-columns:1fr}}
</style>
