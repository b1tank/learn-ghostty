---
const { moments } = Astro.props;
---
<figure class="evolution-strip" aria-labelledby="evolution-title">
  <figcaption id="evolution-title">
    <span>SOURCE ARCHAEOLOGY</span>
    <strong>Then, reconstruction, and now solve different-sized problems</strong>
  </figcaption>
  <ol>
    {moments.map((moment, index) => (
      <li class={`is-${moment.kind}`}>
        <div class="evolution-strip__marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
        <div>
          <small>{moment.eyebrow}</small>
          <strong>{moment.title}</strong>
          <p>{moment.description}</p>
          {moment.href ? <a href={moment.href}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4"/></svg><code>{moment.revision}</code><span>{moment.linkLabel}</span></a> : <code>{moment.revision}</code>}
        </div>
      </li>
    ))}
  </ol>
</figure>
