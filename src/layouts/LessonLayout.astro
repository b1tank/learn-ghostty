---
import BaseLayout from "./BaseLayout.astro";
import LessonTools from "../components/LessonTools.vue";
import { groupedLessons } from "../lib/course.js";
import "../styles/scenarios.css";
const { lesson, lessons, headings, sourceCommit }=Astro.props;const base=import.meta.env.BASE_URL;const modules=groupedLessons(lessons);const published=lessons.filter(x=>x.status==='published');const index=published.findIndex(x=>x.id===lesson.id);const previous=published[index-1],next=published[index+1];const url=p=>`${base}${p.replace(/^\//,'')}`;
---
<BaseLayout title={lesson.title} description={lesson.summary} lessons={lessons}><div class="lesson-shell"><aside class="lesson-sidebar" aria-label="Course lessons">{modules.map(mod=><section><h3>{mod.name}</h3>{mod.lessons.map(item=>item.status==='published'?<a class:list={{active:item.id===lesson.id}} href={url(`/lessons/${item.id}`)}>{String(item.order).padStart(2,"0")} · {item.title}</a>:<a aria-disabled="true">{String(item.order).padStart(2,"0")} · {item.title} · planned</a>)}</section>)}</aside><article><header class="lesson-header"><div class="lesson-header__meta">{lesson.module} · Lesson {String(lesson.order).padStart(2,"0")} · {lesson.duration}</div><h1>{lesson.title}</h1><p>{lesson.summary}</p></header><LessonTools client:only="vue" lesson={lesson} lessons={lessons} base={base} sourceCommit={sourceCommit}/><div class="lesson-content"><slot/></div>{lesson.sourceRefs?.length>0&&<section class="lesson-references"><h2>Source and official references</h2>{lesson.sourceRefs.map(ref=><article><strong>{ref.label}</strong><p>{ref.purpose}</p><div><a href={`https://github.com/ghostty-org/ghostty/blob/${sourceCommit}/${ref.path}#L${ref.line}${ref.end?`-L${ref.end}`:""}`}>Pinned GitHub source ↗</a><code>~/ghostty/{ref.path}:{ref.line}{ref.end?`-${ref.end}`:""}</code>{ref.officialUrl&&<a href={ref.officialUrl}>Official documentation ↗</a>}</div></article>)}</section>}<nav class="lesson-footer-nav">{previous?<a href={url(`/lessons/${previous.id}`)}><span>PREVIOUS</span><strong>← {previous.title}</strong></a>:<a href={url('#roadmap')}><span>COURSE</span><strong>← Roadmap</strong></a>}{next?<a class="next" href={url(`/lessons/${next.id}`)}><span>NEXT</span><strong>{next.title} →</strong></a>:<a class="next" href={url('#roadmap')}><span>COURSE</span><strong>Roadmap →</strong></a>}</nav></article><aside class="lesson-outline" aria-label="On this page"><h2>On this page</h2>{headings.filter(x=>x.depth===2||x.depth===3).map(x=><a class={`depth-${x.depth}`} href={`#${x.slug}`}>{x.text}</a>)}</aside></div></BaseLayout>
