---
import SiteSearch from "../components/SiteSearch.vue";
import "../styles/global.css";
const { title = "Learn Ghostty", description = "Learn Ghostty from PTY bytes to GPU pixels", lessons = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (path) => `${base}${path.replace(/^\//, "")}`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" href={url("ghost-mark.svg")}/><title>{title === "Learn Ghostty" ? title : `${title} | Learn Ghostty`}</title><script is:inline>{`(()=>{const v=localStorage.getItem('learn-ghostty-theme');const d=v?v==='dark':matchMedia('(prefers-color-scheme:dark)').matches;document.documentElement.classList.toggle('dark',d)})()`}</script></head><body><header class="site-header"><div class="site-header__inner"><a class="site-brand" href={url("")}><img src={url("ghost-mark.svg")} alt=""/>Learn Ghostty</a><nav class="site-nav" aria-label="Primary"><a href={url("lessons/00-open-ghostty")}>Start learning</a><a href={url("#roadmap")}>Roadmap</a><SiteSearch client:load lessons={lessons} base={base}/><button class="theme-toggle" aria-label="Toggle color theme" data-theme-toggle>◐</button><a href="https://github.com/b1tank/learn-ghostty" aria-label="GitHub repository">◉</a></nav></div></header><main class="site-main"><slot/></main><footer class="site-footer">Browser-first · source-backed · AI optional · built for human understanding</footer><script is:inline>{`document.querySelector('[data-theme-toggle]')?.addEventListener('click',()=>{const d=!document.documentElement.classList.contains('dark');document.documentElement.classList.toggle('dark',d);localStorage.setItem('learn-ghostty-theme',d?'dark':'light')})`}</script></body></html>
