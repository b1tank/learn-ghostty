---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeExperience from "../components/HomeExperience.vue";
import { getLessons, groupedLessons } from "../lib/course.js";
const lessons=await getLessons();const modules=groupedLessons(lessons);const base=import.meta.env.BASE_URL;
---
<BaseLayout lessons={lessons}><HomeExperience client:load lessons={lessons} modules={modules} base={base}/></BaseLayout>
