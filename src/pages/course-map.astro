---
import BaseLayout from "../layouts/BaseLayout.astro";import {getLessons,groupedLessons} from "../lib/course.js";const lessons=await getLessons(),modules=groupedLessons(lessons),base=import.meta.env.BASE_URL;const url=p=>`${base}${p.replace(/^\//,'')}`;
---
<BaseLayout title="Course map" lessons={lessons}><div class="home-course"><header class="home-intro"><div class="eyebrow">THE COMPLETE PATH</div><h1>Learn the whole machine<br/><em>through real scenarios.</em></h1><p>Start with complete user journeys, then revisit each layer in depth. Published lessons are always open.</p></header><section class="home-roadmap">{modules.map(mod=><section class="roadmap-module"><div class="roadmap-module__title"><h3>{mod.name}</h3><p>{mod.summary}</p></div><div class="roadmap-lessons">{mod.lessons.map(x=>x.status==='published'?<a class="roadmap-lesson" href={url(`/lessons/${x.id}`)}><span>{String(x.order).padStart(2,'0')}</span><div><strong>{x.title}</strong><small>{x.summary}</small></div><b>Available</b></a>:<div class="roadmap-lesson"><span>{String(x.order).padStart(2,'0')}</span><div><strong>{x.title}</strong><small>{x.summary}</small></div><b>Planned</b></div>)}</div></section>)}</section></div></BaseLayout>
